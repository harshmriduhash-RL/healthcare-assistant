# Database
DATABASE_URL=postgresql+asyncpg://healthcare_user:changeme@localhost:5432/healthcare_ai
DATABASE_URL_SYNC=postgresql://healthcare_user:changeme@localhost:5432/healthcare_ai

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_SUPERVISOR=llama-3.3-70b-versatile
GROQ_MODEL_WORKER=llama-3.3-70b-versatile
GROQ_MODEL_GUARDRAIL=llama-3.1-8b-instant

# Auth
JWT_SECRET_KEY=change_this_to_a_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# App
APP_ENV=development
UPLOAD_DIR=uploads/medical_records
MAX_UPLOAD_MB=15
